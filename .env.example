# Copia este archivo como .env y rellena los valores.
#   cp .env.example .env

# ---- Django ---------------------------------------------------------------
SECRET_KEY=change-me-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Correo SMTP (obligatorio para recuperar contraseña y enviar facturas) --
# Ejemplo con Gmail: usa una "Contraseña de aplicaciones" de 16 letras
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de
# aplicaciones), NO la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# En desarrollo puedes imprimir los correos en la terminal en lugar de enviarlos:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Vida útil del enlace de recuperación de contraseña, en segundos (24 h).
PASSWORD_RESET_TIMEOUT=86400

# ---- Correo de contacto mostrado en la interfaz ----------------------------
CORREO_CONTACTO=contacto@kanview.com

# ---- Datos del emisor en facturas -----------------------------------------
EMPRESA_NOMBRE=Kanview · Cuir Tapicería
EMPRESA_NIT=000.000.000-0
EMPRESA_DIRECCION=Dirección del taller
EMPRESA_TELEFONO=000 000 0000
EMPRESA_CORREO=contacto@kanview.com
FACTURA_IVA=0

# ---- Varios ----------------------------------------------------------------
TERMINOS_VERSION=1.0
BACKUP_DIR=backups
BACKUP_RETENCION=10
MAX_VIDEO_BYTES=26214400
MAX_BYTES_MULTIMEDIA=26214400
